{
  "name": "merchant-desk-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the USDT Merchant Desk: KYC-gated P2P USDT/INR orders with escrow, disputes and live chat.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
