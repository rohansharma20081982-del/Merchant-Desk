# Copy to .env and fill in. JWT_SECRET has no default on purpose.
PORT=4000
NODE_ENV=development

# Transactions need a replica set. docker-compose.yml starts one on localhost:27017.
MONGO_URI=mongodb+srv://rohansharma20081982_db_user:rohan2008sha@cluster0.muhih8x.mongodb.net/?appName=Cluster0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of front-end origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Fixed rate for the prototype, in rupees per 1 USDT
RATE_INR_PER_USDT=109

# Day boundaries for the daily limit use the server time zone
TZ=Asia/Kolkata

# Only used by `npm run seed:admin`
ADMIN_EMAIL=rohan@email.com
ADMIN_PASSWORD=rohan2008sha