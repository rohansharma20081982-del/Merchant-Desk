# ==============================================================================
# Merchant Desk - Environment Configuration (.env.example)
# Safe template for development and production deployments.
# Copy this file to `.env` and configure with your environment-specific values.
# NEVER commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# Server HTTP listening port (default: 4000)
PORT=4000

# Application runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB replica set connection URI (replica set required for multi-document ACID transactions)
MONGO_URI=mongodb://127.0.0.1:27017/merchant_desk?replicaSet=rs0

# Application and branding display name
APP_NAME=Merchant Desk

# Cryptographic signing secret for JWT auth tokens (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your_jwt_secret_hex_at_least_32_bytes_long

# Dedicated secret for HMAC-SHA256 OTP hashing (optional, defaults to JWT_SECRET)
OTP_SECRET=your_otp_secret_hex_at_least_32_bytes_long

# Comma-separated list of front-end origins permitted to access API endpoints via CORS and CSRF checks
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory path for dispute proof file uploads (defaults to 'uploads' or '/tmp/uploads' on Vercel)
UPLOAD_DIR=uploads

# Google OAuth 2.0 Client ID for Google Identity Services sign-in with verified email
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Fixed trading conversion rate (Rupees per 1 USDT)
RATE_INR_PER_USDT=109

# Timezone identifier used for daily volume limit window calculation
TZ=Asia/Kolkata

# Admin account email address (used only when running `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com

# Admin account initial password of at least 12 characters (used only when running `npm run seed:admin`)
ADMIN_PASSWORD=change_this_to_a_secure_long_password_123

# Base URL for API testing (used by `scripts/smoke.js`)
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# OTP & Multi-Factor Verification Configuration
# ------------------------------------------------------------------------------

# Time-to-live for one-time verification codes in seconds (default: 300 = 5 minutes)
OTP_TTL_SECONDS=300

# Mandatory cooldown period between consecutive OTP requests in seconds (default: 60)
OTP_COOLDOWN_SECONDS=60

# Maximum permitted incorrect verification attempts before code is invalidated (default: 5)
OTP_MAX_ATTEMPTS=5

# Maximum allowed OTP requests per destination per hour to prevent abuse (default: 5)
OTP_MAX_SENDS_PER_HOUR=5

# Require mandatory phone verification during initial user onboarding ('true' | 'false')
REQUIRE_PHONE_VERIFICATION=false

# Require mandatory email verification before full platform feature access ('true' | 'false')
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# Email Gateway Provider Settings
# ------------------------------------------------------------------------------

# Email delivery provider selection ('mock' | 'smtp')
EMAIL_PROVIDER=mock

# SMTP mail server hostname (e.g. smtp.gmail.com, smtp-relay.brevo.com, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.example.com

# SMTP port number (587 for STARTTLS, 465 for SSL/TLS, 25 for unencrypted relay)
SMTP_PORT=587

# SMTP authentication username or service account email
SMTP_USER=your_smtp_username_or_email

# SMTP authentication password or app password
SMTP_PASS=your_smtp_password

# Default 'From' email address appearing in outgoing verification emails
EMAIL_FROM=no-reply@merchantdesk.local